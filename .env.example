# Copy to .env.local and fill in. .env.local is git-ignored and never committed.
# Names only here — never a value.

# --- benchmark harness + Render worker: LLM arms -------------------------
INCEPTION_API_KEY=
ANTHROPIC_API_KEY=

# --- TTS, held constant across both arms ---------------------------------
ELEVENLABS_API_KEY=
# Pinned so the worker and scripts/render-audio.ts cannot drift apart.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- LiveKit. Vercel needs all three (server-side only, never NEXT_PUBLIC).
# The Render worker needs them too.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
