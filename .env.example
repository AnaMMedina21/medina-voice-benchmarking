# Copy to .env.local and fill in. .env.local is git-ignored and must never be committed.
# Names only here — never a value, not even a placeholder that looks real.

# Arm A — Inception Mercury 2, via the LiveKit OpenAI plugin (OpenAI-compatible endpoint)
INCEPTION_API_KEY=

# Arm B — Anthropic Claude Haiku 4.5, via the LiveKit Anthropic plugin
ANTHROPIC_API_KEY=
# Not read by agent.py. Anthropic keys that are identity-linked return
# 400 'anthropic-workspace-id is required'; if yours does, this is the id to
# pass as a default header on a custom anthropic.AsyncClient. The key in use
# authenticates without it, so the code path does not exist yet.
WORKSPACE_ID=

# TTS, held constant across both arms
ELEVENLABS_API_KEY=

# LiveKit. Required only if the session is started against a real room;
# the headless benchmark starts AgentSession with no room.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
